#include <windows.h>
#include "../src/resource.h"

#pragma code_page(1252)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "app.ico"

1 RT_MANIFEST "OpenSubst.manifest"

/* Folder link editor. All texts are set at runtime from the language table. */
IDD_LINK DIALOGEX 0, 0, 300, 160
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenSubst"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_LK_LBLLINK, 7, 10, 34, 9
    EDITTEXT        IDC_LK_LINK, 44, 8, 226, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_LK_LINKBTN, 273, 8, 20, 13
    LTEXT           "", IDC_LK_LBLTARGET, 7, 28, 34, 9
    EDITTEXT        IDC_LK_TARGET, 44, 26, 226, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_LK_TARGETBTN, 273, 26, 20, 13
    LTEXT           "", IDC_LK_HINT, 44, 46, 249, 88
    DEFPUSHBUTTON   "OK", IDOK, 189, 139, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 139, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rekow IT"
            VALUE "FileDescription", "OpenSubst - virtual drive manager"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "OpenSubst"
            VALUE "LegalCopyright", "Copyright \251 2026 Rekow IT. MIT License."
            VALUE "OriginalFilename", "OpenSubst.exe"
            VALUE "ProductName", "OpenSubst"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
