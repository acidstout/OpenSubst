#include <windows.h>
#include "../src/resource.h"

#pragma code_page(1252)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "app.ico"

1 RT_MANIFEST "OpenSubst.manifest"


VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rekow IT"
            VALUE "FileDescription", "OpenSubst - virtual drive manager"
            VALUE "FileVersion", "1.0.2.0"
            VALUE "InternalName", "OpenSubst"
            VALUE "LegalCopyright", "Copyright \251 2026 Rekow IT. MIT License."
            VALUE "OriginalFilename", "OpenSubst.exe"
            VALUE "ProductName", "OpenSubst"
            VALUE "ProductVersion", "1.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
